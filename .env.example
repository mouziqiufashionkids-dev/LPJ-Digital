# ==============================================================
# MODE DEMO — biarkan kosong, aplikasi jalan dengan data contoh.
# ==============================================================
# Isi kedua nilai di bawah untuk beralih ke database Supabase
# (buat project gratis di https://supabase.com lalu jalankan
#  supabase/schema.sql di SQL Editor):
#
# URL proyek Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings -> API) — HANYA untuk server,
# jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
