# ==============================================================
# MODE DEMO — biarkan kosong semua, aplikasi jalan dengan data contoh.
# (npm install && npm run dev → langsung bisa dicoba tanpa database)
# ==============================================================

# ------------------------------------------------------------
# Isi DUA nilai di bawah untuk beralih ke database Supabase
# (buat project gratis di https://supabase.com lalu jalankan
#  supabase/schema.sql di SQL Editor):
#
# URL proyek Supabase (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings → API → service_role, yang SECRET)
# HANYA untuk server — jangan pernah diberi awalan NEXT_PUBLIC_ !
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# SANDI PANEL PANITIA (/admin) — WAJIB DIGANTI untuk produksi!
# Akses panel: klik logo masjid 3x di web, atau buka /admin/login
# ------------------------------------------------------------
ADMIN_PASSWORD=alhikmah2026

# ------------------------------------------------------------
# OPSIONAL — kustomisasi lanjutan:
#
# Domain custom (mis. https://masjidku.my.id) — dipakai untuk
# tautan di pesan WhatsApp. Kalau kosong, otomatis pakai domain Vercel.
# NEXT_PUBLIC_SITE_URL=
#
# Kunci tambahan untuk melindungi endpoint cron dari akses liar
# (Vercel akan otomatis mengirimkannya sebagai Bearer tiap jam 20:00 WIB)
# CRON_SECRET=
