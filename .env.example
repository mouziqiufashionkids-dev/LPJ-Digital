# URL proyek Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings -> API) — HANYA untuk server,
# jangan pernah diberi awalan NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================
# SANDI PANEL PANITIA (/admin)
# Ganti untuk produksi! Akses panel: klik logo masjid 3x di web
# atau langsung buka /admin/login
